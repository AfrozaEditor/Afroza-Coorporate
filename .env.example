# Copier en .env.local (développement) et renseigner les mêmes variables
# dans l'hébergeur (Vercel › Settings › Environment Variables) pour la prod.

# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé « publishable » (sb_publishable_…). L'ancienne clé « anon » fonctionne aussi :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Adresse publique du site, utilisée dans les e-mails « mot de passe oublié ».
NEXT_PUBLIC_SITE_URL=https://afroza-editor.tech

# Lien d'abonnement à la chaîne WhatsApp (bouton « S'abonner » des news repartagées).
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
